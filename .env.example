# =====================================================================
# .env.example — Variables compartidas committed al repo
# Copia este archivo a .env y rellena los valores marcados como personales.
# =====================================================================

# ---------------------------------------------------------------------
# AWS — Credenciales y región
# ---------------------------------------------------------------------
# Perfil AWS SSO local (ver docs/SETUP-AWS.md)
AWS_PROFILE=base-apps-dev
AWS_REGION=us-east-1


# ---------------------------------------------------------------------
# Neon — Postgres serverless
# Ver docs/SETUP-NEON.md
# ---------------------------------------------------------------------

# ID de tu organización Neon (compartido todo el equipo, NO es secret)
NEON_ORG_ID=

# API key personal de Neon (PERSONAL — cada dev la suya, NO commitear)
# Setear en .env (no en .env.example)
NEON_API_KEY=

# ID del proyecto Neon `base-apps-dev` compartido (committed; se llena tras 1er deploy de dev)
# Sólo se necesita en stages personales — referencia al proyecto compartido para crear branches.
NEON_DEV_PROJECT_ID=


# ---------------------------------------------------------------------
# AWS — Recursos compartidos del stage `dev`
# Se llenan después del primer `sst deploy --stage dev` y son committeados.
# Sólo se usan en stages personales para referenciar la infra compartida.
# ---------------------------------------------------------------------

# ID de la VPC compartida del stage `dev` (creada por el primer deploy)
# Personal stages la referencian para no duplicar VPC + NAT por developer.
SHARED_DEV_VPC_ID=


# ---------------------------------------------------------------------
# Dev local — opcional
# ---------------------------------------------------------------------
# Connection string. Lo usan: el standalone de los servicios NestJS
# (`pnpm --filter <svc> dev`) y las migraciones drizzle (`pnpm --filter @app/db db:migrate`).
# Cópialo de tu branch Neon (Neon console → Connection Details) o del output de
# `sst deploy`. Ver docs/SETUP-NEON.md.
DATABASE_URL=

# Servicios NestJS en local (standalone). Opcionales (tienen default).
NODE_ENV=development
# PORT=3001        # si corres 2 servicios a la vez, override inline: PORT=3002 pnpm --filter <svc> dev


# ---------------------------------------------------------------------
# Auth0 — config local (la comparten apps/web y los servicios NestJS)
# Ver docs/SETUP-AUTH0.md. Solo necesario para probar rutas autenticadas.
# ---------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.example.com
# AUTH0_NAMESPACE=https://app.example.com/   # default si se omite
# APP_BASE_URL=http://localhost:3000          # web local (redirect_uri del callback)
# Secretos del login web (PERSONALES — NO commitear; en deploy van como GitHub
# Environment Secret. Misma env var en local y en CI, una sola fuente de verdad):
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                                # openssl rand -hex 32
